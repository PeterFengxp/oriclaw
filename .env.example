# LLM Provider Selection
# Options: claude, minimax, kimi, deepseek
LLM_PROVIDER=claude

# Anthropic Claude API Key for multimodal processing
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MiniMax API Keys (required if using MiniMax provider)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here

# Kimi (Moonshot AI) API Key (required if using Kimi provider)
KIMI_API_KEY=your_kimi_api_key_here

# DeepSeek API Key (required if using DeepSeek provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: OpenAI API Key for Whisper speech recognition
OPENAI_API_KEY=your_openai_api_key_here

# Browser settings
HEADLESS=false
